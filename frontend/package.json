        "vue-i18n": "^11.1.9",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@graphql-codegen/cli": "^6.2.1",
        "@types/bootstrap": "^5.2.10",
        "@types/lodash": "^4.17.20",
        "@typescript-eslint/parser": "^8.34.0",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.5.0",
        "eslint": "^9.28.0",
        "eslint-plugin-vue": "^10.2.0",

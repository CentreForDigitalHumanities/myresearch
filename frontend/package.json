{
    "name": "my-research-frontend",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "i18n-extract": "npx vue-i18n-extract report --vueFiles \"./{components,pages,layouts,composables}/**/*.{ts,vue}\" --languageFiles \"./locales/**/*.{json,yml,yaml,js}\" --add",
        "codegen": "graphql-codegen --verbose --watch",
        "codegen-prod": "graphql-codegen",
        "i18n-check": "python i18n-check.py",
        "test": "vitest"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^6.7.2",
        "@fortawesome/free-solid-svg-icons": "^6.7.2",
        "@fortawesome/vue-fontawesome": "^3.3.3",
        "@nuxt/eslint": "^1.17.0",
        "@nuxt/test-utils": "^4.1.0",
        "@pinia/nuxt": "^0.11.3",
        "@vue/apollo-composable": "^4.2.2",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "apollo-client": "^2.6.10",
        "bootstrap": "^5.3.8",
        "cdh-vue-lib": "github:CentreForDigitalHumanities/Vue-lib#v0.7.0-0",
        "dotenv": "^17.4.2",
        "graphql": "^15.10.2",
        "graphql-tag": "^2.12.7",
        "lodash": "^4.18.1",
        "lucide-vue-next": "^0.544.0",
        "nuxt": "^3.21.1",
        "pinia": "^3.0.4",
        "uu-bootstrap": "github:UtrechtUniversity/UU-Bootstrap#v1.5.0-alpha.1",
        "uuid": "^14.0.1",
        "vue": "^3.5.41",
        "vue-apollo": "^3.1.2",
        "vue-i18n": "^11.4.8",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@graphql-codegen/cli": "^6.3.1",
        "@types/bootstrap": "^5.2.11",
        "@types/lodash": "^4.17.25",
        "@typescript-eslint/parser": "^8.34.0",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^9.39.5",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^16.5.0",
        "prettier": "^3.9.6",
        "prettier-eslint": "^16.4.2",
        "sass-embedded": "^1.102.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
